# Example of config/pi.env, which scripts/stack/pi_detect.sh writes (make pi-detect). Do not copy by hand.
# Plain KEY=value lines: read by the stack scripts (bash) and by the Pi's systemd units (EnvironmentFile).
CABLE_IF=enp0s20f0u1c2
LAPTOP_IP=169.254.0.1
PI_V4=169.254.0.2
PI_V6=fe80::1
PI_USER=pi
PI_KEY=/home/you/.ssh/id_ed25519_pi
PI_REPO=/home/pi/Documents/AI-231-ME3
PI_AUDIO_DEVICE=CD002-AUDIO
PI_SPEAKER_RATE=48000
PI_LD_LIBRARY_PATH=
PORT_ROUTER=8089
PORT_SPEECH=8770
PORT_AGENT=8781
PORT_PI_SPEAKER=8780
PORT_PI_DEVICE=8790
DETECTED_AT=2026-01-01T00:00:00+0000
