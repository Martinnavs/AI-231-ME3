[Unit]
Description=Pi loudspeaker (scripts/pi_speaker.py) for the laptop voice stack
After=network-online.target sound.target
Wants=network-online.target
ConditionPathExists=%h/.config/lan_speech_token

[Service]
# @REPO@ is filled in by deploy/install-pi.sh. PI_AUDIO_DEVICE is the stable ALSA card name (not a card number).
EnvironmentFile=@REPO@/config/pi.env
ExecStart=@REPO@/scripts/stack/pi_service.sh speaker
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
