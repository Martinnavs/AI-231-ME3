[Unit]
Description=Pi agent harness (Pipecat agent server, MCP children, apps server) for the laptop voice stack
After=network-online.target
Wants=network-online.target
ConditionPathExists=%h/.config/lan_speech_token

[Service]
# @REPO@ is filled in by deploy/install-pi.sh. The API keys are the key files under ~/.secrets, as on the laptop.
EnvironmentFile=@REPO@/config/pi.env
ExecStart=@REPO@/scripts/stack/pi_service.sh agent
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
